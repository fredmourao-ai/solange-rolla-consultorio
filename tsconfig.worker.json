{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": ".worker-dist",
    "rootDir": ".",
    "incremental": false,
    "isolatedModules": false,
    "plugins": [],
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "scripts/document-worker.ts",
    "src/workers/document-worker-runtime.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
